@article{yang2022griffin,
  abbr      = {TNSM},
  title     = {Griffin: Real-Time Network Intrusion Detection System via Ensemble of Autoencoder in SDN},
  author    = {Yang, Liyan and Song, Yubo and Gao, Shang and Hu, Aiqun and Xiao, Bin},
  journal   = {IEEE Transactions on Network and Service Management},
  volume    = {19},
  number    = {3},
  pages     = {2269--2281},
  year      = {2022},
  month     = {Sep},
  pdf       = {https://www4.comp.polyu.edu.hk/%7Ecsbxiao/paper/2022/TNSM-Griffin-intrusion%20detection.pdf},
  selected  = {true},
  abstract  = {Many efforts have been devoted to the development of efficient Network Intrusion Detection Systems (NIDS) using machine learning approaches in Software-defined Networking (SDN). Unfortunately, existing solutions failed to detect real-time and zero-day attacks due to their limited throughput and prior knowledge-based detection. To this end, we propose Griffin, a NIDS that uses unsupervised machine learning to detect both known and zero-day intrusion attacks in real time with high accuracy. Griffin uses an efficient feature extraction framework to capture the sequential features of traffic packets, cluster analysis to reduce the feature scale, and an ensemble of autoencoders to extract features with low complexity and high precision. Evaluations on open datasets show that Griffin's complexity is about 40\% lower, and its accuracy is at most 19\% higher than existing NIDS. Even under evasion, the decrease in AUC is at most 9\%. The paper also uses differential privacy while training the autoencoders to protect the privacy of the datasets.}
}
